# Variables d'environnement de la commande /suxa_tondeuse (a cote de DISCORD_TOKEN).
# Copier en .env sur le VPS du bot, ou exporter directement dans l'environnement.

# URL de base du backend SUXA TONDEUSE (inclut le suffixe /api).
ROBOMOW_API_URL=http://localhost:3100/api

# Cle partagee avec le backend : doit correspondre a DISCORD_BOT_API_KEY cote
# backend (voir .env.example racine). Sert a signer les requetes d'invite.
ROBOMOW_BOT_KEY=change_me_bot_shared_key
