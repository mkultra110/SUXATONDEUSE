# Dockerfile dev pour le frontend : Vite en mode HMR.
FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
COPY frontend/package.json ./frontend/
COPY shared/package.json ./shared/
RUN npm ci --workspaces --include-workspace-root

COPY shared ./shared
COPY frontend ./frontend
COPY tsconfig.base.json ./

EXPOSE 5173
CMD ["npm", "run", "dev", "--workspace=@robomow/frontend"]
