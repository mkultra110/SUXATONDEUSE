# ─── Backend ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://game:gamepass@localhost:5432/robomow

# Secrets (generer avec : openssl rand -hex 32 / 64)
JWT_SECRET=change_me_jwt_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
SAVE_HMAC_SECRET=change_me_hmac_secret_minimum_64_chars_for_anti_cheat_signature

# URL du frontend pour CORS
FRONTEND_URL=http://localhost:5173

# Niveau de log : trace | debug | info | warn | error
LOG_LEVEL=info

# ─── Invites Discord (commande /suxa_tondeuse) ──────────────
# Cle partagee entre le bot Discord et le backend (generer avec openssl rand -hex 32)
DISCORD_BOT_API_KEY=
# URL publique du jeu (tunnel Cloudflare ou domaine final)
PUBLIC_GAME_URL=http://localhost:5173

# ─── Frontend (build-time, prefixe VITE_) ───────────────────
VITE_API_URL=http://localhost:3000/api
